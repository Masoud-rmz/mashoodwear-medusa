# Copy to `.env` for local development (`cp .env.template .env`).
# Secrets stay local — never commit `.env`.

MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs

# --- Local (Vite storefront on :5173) ---
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# --- Production (replace before NODE_ENV=production) ---
# STORE_CORS=https://shop.example.com
# ADMIN_CORS=https://admin.example.com
# AUTH_CORS=https://shop.example.com,https://admin.example.com
# Never include docs.medusajs.com or broad localhost in production.
# CORS_PRODUCTION_GUARD=0  # only to temporarily bypass the startup guard (not recommended)

REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_local_dev_jwt_secret_32chars
COOKIE_SECRET=CHANGE_ME_local_dev_cookie_secret_32
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_local_dev_mfa_key_32ch
# Matches root docker-compose.yml postgres service
DATABASE_URL=postgresql://medusa:medusa_dev@localhost:5433/medusa_store
DB_NAME=medusa_store
IRAN_BANK_ADAPTER=stub
IRAN_BANK_MERCHANT_ID=stub-merchant
IRAN_BANK_TERMINAL_ID=stub-terminal
IRAN_BANK_SECRET_KEY=CHANGE_ME
IRAN_BANK_CALLBACK_BASE_URL=http://localhost:9000

# Phone OTP (SMS.ir VERIFY) — stub when key/template missing or SMS_IR_STUB=1
PHONE_AUTH_JWT_SECRET=CHANGE_ME_local_dev_phone_jwt_32ch
SMS_IR_STUB=1
# SMS_IR_API_KEY=
# SMS_IR_TEMPLATE_ID=
