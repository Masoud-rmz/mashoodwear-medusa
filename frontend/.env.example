# Copy to `.env` and fill values from Medusa Admin → Publishable API Keys
VITE_MEDUSA_BACKEND_URL=http://localhost:9000
VITE_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
VITE_MEDUSA_DEFAULT_COUNTRY=ir
# Optional but recommended (Iran region from `GET /store/regions`)
# VITE_MEDUSA_REGION_ID=reg_...
VITE_MEDUSA_ADMIN_URL=http://localhost:9000/app
VITE_COMMERCE_PROVIDER=medusa
