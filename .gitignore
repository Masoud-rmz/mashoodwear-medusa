# Dependencies
node_modules/

# Environment secrets
.env
**/.env
!**/.env.example
!**/.env.template
backend/.env
frontend/.env
frontend/.env.local
apps/medusa/.env

# Medusa build / cache
apps/medusa/.medusa/
apps/medusa/dist/
apps/medusa/build/
apps/medusa/coverage/

# Build output — run `npm run build` on deploy
frontend/dist/

# Runtime uploads (seed SVG placeholders are tracked)
backend/uploads/**
!backend/uploads/.gitkeep
!backend/uploads/products/
backend/uploads/products/*
!backend/uploads/products/*.svg
backend/uploads/lookbook/**

# One-way Express → Medusa product export snapshots
backend/exports/

# Test artifacts
tests/e2e/test-results/
tests/e2e/playwright-report/
playwright/.cache/

# One-off local deploy helpers (never commit)
_*.py
_*.sh
_deploy_tail.txt
_remote_*.sh

# Logs and OS
*.log
.DS_Store
Thumbs.db
