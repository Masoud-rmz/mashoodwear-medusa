[Unit]
Description=Mashoodwear Medusa Iran Pack
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mashoodwear/apps/medusa
EnvironmentFile=/opt/mashoodwear/apps/medusa/.env
Environment=NODE_ENV=production
# purpose --- CLI may be hoisted to monorepo root node_modules ---
ExecStart=/usr/local/bin/node /opt/mashoodwear/node_modules/@medusajs/cli/cli.js start
Restart=on-failure
RestartSec=8
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
